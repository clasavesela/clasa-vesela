rules_version = '2';

// =====================================================================
//  Reguli de securitate – Clasa Veselă
//  UID-ul de administrator e deja pus mai jos (funcția isAdmin).
//  Lipește tot fișierul în Firebase Console → Firestore → Rules → Publish.
//
//  Cine ce poate face:
//   • administrator (un singur UID): creează / activează / dezactivează profesori,
//     vede tot.
//   • profesor (are document activ în /teachers, creat DOAR de administrator):
//     își creează clase (cel mult câte i-a permis administratorul – maxClasses), adaugă / șterge elevi, vede fișele elevilor lui.
//   • copil (autentificat anonim): citește clasa al cărei cod îl știe și lista
//     de nume, și își poate adăuga puncte doar prin trimiterea unei fișe.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // cont cu email și parolă (nu copil autentificat anonim)
    function hasEmailAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'h57UZDmgtMYmOu9CJG3CSZP2qeU2';
    }

    function isTeacher() {
      let path = /databases/$(database)/documents/teachers/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.active == true;
    }

    function ownsClass(code) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
    }

    // Limita de clase: odată cu clasa nouă, profesorul crește classCount cu 1 (în aceeași
    // scriere), iar noua valoare nu poate depăși maxClasses (5 dacă nu a fost setat).
    function withinClassLimit() {
      let path = /databases/$(database)/documents/teachers/$(request.auth.uid);
      let before = get(path).data;
      let after = getAfter(path).data;
      return after.get('classCount', 0) == before.get('classCount', 0) + 1
        && after.get('classCount', 0) <= before.get('maxClasses', 5);
    }

    // Copilul trimite o fișă:
    //  • fișele cresc exact cu 1, cu 1–10 răspunsuri, dintre care cel mult toate corecte;
    //  • punctele cresc cu cel mult 40 pe răspuns corect (nivelul maxim) + 50 bonus,
    //    iar bonusul (perfect + 1) se dă doar dacă toate răspunsurile sunt corecte;
    //  • cel mult o fișă la 10 secunde pentru același elev (oprește trimiterile automate).
    function validSheetUpdate() {
      let d = request.resource.data;
      let o = resource.data;
      let dc = d.correct - o.correct;
      let da = d.answered - o.answered;
      let dperf = d.perfect - o.perfect;
      return signedIn()
        && d.diff(o).affectedKeys().hasOnly(
             ['points', 'sheets', 'perfect', 'correct', 'answered', 'recent', 'lastLabel', 'lastActive'])
        && d.sheets == o.sheets + 1
        && d.correct is int && d.answered is int && d.perfect is int && d.points is int
        && da >= 1 && da <= 10
        && dc >= 0 && dc <= da
        && (dperf == 1) == (dc == da) && (dperf == 0 || dperf == 1)
        && d.points >= o.points && d.points - o.points <= dc * 40 + dperf * 50
        && d.recent is list && d.recent.size() <= 10
        && d.lastLabel is string && d.lastLabel.size() <= 100
        && d.lastActive == request.time
        && (o.get('lastActive', null) == null || request.time > o.lastActive + duration.value(10, 's'));
    }

    // O fișă salvată trebuie să vină odată cu actualizarea punctelor elevului
    // (aceeași tranzacție) și să aibă exact aceleași cifre.
    function validResult(code, sid) {
      let r = request.resource.data;
      let path = /databases/$(database)/documents/classes/$(code)/students/$(sid);
      let before = get(path).data;
      let after = getAfter(path).data;
      return signedIn()
        && exists(path)
        && r.keys().hasOnly(['date', 'label', 'type', 'correct', 'total', 'points', 'items'])
        && r.date == request.time
        && r.label is string && r.label.size() <= 100
        && r.type is string && r.type.size() <= 30
        && r.total is int && r.total >= 1 && r.total <= 10
        && r.correct is int && r.correct >= 0 && r.correct <= r.total
        && r.points is int && r.points >= 0 && r.points <= 450
        && r.items is list && r.items.size() <= 10
        && after.sheets == before.sheets + 1
        && after.answered - before.answered == r.total
        && after.correct - before.correct == r.correct
        && after.points - before.points == r.points;
    }

    function validStudent(d) {
      return d.keys().hasOnly(['name', 'avatar', 'points', 'sheets', 'perfect', 'correct', 'answered',
                               'recent', 'lastLabel', 'lastActive', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.avatar is string && d.avatar.size() <= 8
        && d.points == 0 && d.sheets == 0 && d.perfect == 0 && d.correct == 0 && d.answered == 0
        && d.recent == [] && d.lastLabel == '' && d.lastActive == null
        && d.createdAt == request.time;
    }

    // ---------- Profesori: scrie doar administratorul ----------
    match /teachers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // grade = clasa la care predă (0 = pregătitoare … 4 = a IV-a), folosită pentru Comper;
      // gradeYear = anul școlar în care a fost setată (de acolo crește singură în fiecare septembrie)
      // maxClasses = câte clase are voie să creeze profesorul (setat doar de administrator)
      allow create, update: if isAdmin()
        && (!('grade' in request.resource.data)
            || (request.resource.data.grade is int && request.resource.data.grade >= 0 && request.resource.data.grade <= 4))
        && (!('gradeYear' in request.resource.data) || request.resource.data.gradeYear == null
            || request.resource.data.gradeYear is int)
        && (!('maxClasses' in request.resource.data)
            || (request.resource.data.maxClasses is int
                && request.resource.data.maxClasses >= 0 && request.resource.data.maxClasses <= 100));
      // Profesorul își poate modifica doar numărătoarea de clase (classCount), odată cu
      // crearea / ștergerea unei clase. Scăderea e permisă doar dacă în aceeași scriere
      // se șterge chiar o clasă a lui (classOp = codul ei), ca să nu poată ocoli limita.
      allow update: if isTeacher() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classCount', 'classOp'])
        && request.resource.data.classCount is int
        && (request.resource.data.classCount == resource.data.get('classCount', 0) + 1
            || (request.resource.data.classOp is string
                && exists(/databases/$(database)/documents/classes/$(request.resource.data.classOp))
                && get(/databases/$(database)/documents/classes/$(request.resource.data.classOp)).data.teacherUid == uid
                && !existsAfter(/databases/$(database)/documents/classes/$(request.resource.data.classOp))
                && ((resource.data.get('classCount', 0) > 0
                     && request.resource.data.classCount == resource.data.get('classCount', 0) - 1)
                    || (resource.data.get('classCount', 0) <= 0 && request.resource.data.classCount == 0))));
      allow delete: if isAdmin();
    }

    // ---------- Profesori șterși: contul de autentificare se șterge singur ----------
    // Administratorul pune marcajul când șterge profesorul. Profesorul își vede doar
    // propriul marcaj și și-l poate scoate / pune la loc când își șterge contul.
    match /deletedTeachers/{uid} {
      allow read, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (hasEmailAccount() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['email', 'name', 'deletedAt']));
      allow update: if isAdmin();
    }

    // ---------- Clase (ID-ul documentului = codul clasei) ----------
    match /classes/{code} {
      // oricine știe codul poate vedea numele clasei; lista tuturor claselor NU
      allow get: if signedIn();
      allow list: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      // clasa (pregătitoare – a IV-a, pentru Comper) vine din contul profesorului,
      // setat de administrator; profesorul nu o poate schimba
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['name', 'teacherUid', 'teacherName', 'grade', 'gradeYear', 'createdAt'])
        && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.get('grade', null)
           == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('grade', null)
        && request.resource.data.get('gradeYear', null)
           == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('gradeYear', null)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && withinClassLimit();
      // doar administratorul modifică o clasă existentă (clasa Comper a profesorului)
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      // ---------- Elevi ----------
      match /students/{sid} {
        allow read: if signedIn();
        allow create: if (isAdmin() || ownsClass(code)) && validStudent(request.resource.data);
        allow delete: if isAdmin() || ownsClass(code);
        // profesorul nu modifică elevii (doar îi adaugă / șterge); copilul doar trimite fișe
        allow update: if isAdmin() || validSheetUpdate();

        // ---------- Fișele rezolvate (cu răspunsurile copilului) ----------
        match /results/{rid} {
          allow read, delete: if isAdmin() || ownsClass(code);
          allow create: if validResult(code, sid);
          allow update: if false;
        }
      }
    }

    // orice altceva: interzis
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
